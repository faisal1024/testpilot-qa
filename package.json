{
  "name": "testpilot-qa-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "A developer-experience layer and project accelerator for Playwright.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke:mvp": "node scripts/smoke-mvp.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "docs:rules": "node scripts/generate-rule-docs.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "clean": "pnpm -r exec rimraf dist && rimraf tsconfig.tsbuildinfo",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,json,jsonc}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.9",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^2.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "yaml": "^2.6.1"
  }
}
