{
  "name": "testpilot-qa",
  "version": "0.1.0-alpha.0",
  "description": "Local-first Playwright quality toolkit: static locator analysis, quality scoring, brownfield baselines, SARIF/HTML reports, safe mechanical fixes, diagnostics, and AI-agent guidance.",
  "keywords": [
    "playwright",
    "testing",
    "e2e",
    "locators",
    "test-quality",
    "qa",
    "sarif",
    "linter",
    "static-analysis",
    "ai-agents"
  ],
  "license": "MIT",
  "author": "Faisal Islam",
  "homepage": "https://github.com/faisal1024/testpilot-qa#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faisal1024/testpilot-qa.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/faisal1024/testpilot-qa/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "testpilot": "./dist/cli.js",
    "testpilot-qa": "./dist/cli.js",
    "tpq": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.68.0",
    "commander": "^12.1.0",
    "jiti": "^2.4.2",
    "tinyglobby": "^0.2.10",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testpilot/ai": "workspace:*",
    "@testpilot/core": "workspace:*",
    "@testpilot/locator-intelligence": "workspace:*",
    "@testpilot/scaffold": "workspace:*"
  }
}
